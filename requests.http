@base = http://localhost:8080
@seller_email = seller@example.com
@seller_password = change-seller-password
@admin_email = admin@example.com
@admin_password = change-admin-password
@email = buyer@example.com
@password = change-buyer-password
@seller_token = paste-seller-access-token
@access_token = paste-buyer-access-token
@refresh_token = paste-buyer-refresh-token
@admin_token = paste-admin-access-token
@product = paste-product-id
@order = paste-order-id

POST {{base}}/auth/login
Content-Type: application/json

{"email":"{{seller_email}}","password":"{{seller_password}}"}

###
POST {{base}}/auth/login
Content-Type: application/json

{"email":"{{admin_email}}","password":"{{admin_password}}"}

###
POST {{base}}/products
Authorization: Bearer {{seller_token}}
Content-Type: application/json

{"name":"Book","price":100.00,"stock":10,"category":"Books","status":"ACTIVE"}

###
POST {{base}}/promo-codes
Authorization: Bearer {{seller_token}}
Content-Type: application/json

{"code":"DEMO10","discount_type":"PERCENTAGE","discount_value":10.00,"min_order_amount":100.00,"max_uses":10,"valid_from":"2026-01-01T00:00:00Z","valid_until":"2030-01-01T00:00:00Z","active":true}

###
POST {{base}}/auth/register
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

###
POST {{base}}/auth/login
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

###
GET {{base}}/products?page=0&size=20&status=ACTIVE&category=Books
Authorization: Bearer {{access_token}}

###
POST {{base}}/orders
Authorization: Bearer {{access_token}}
Content-Type: application/json

{"items":[{"product_id":"{{product}}","quantity":2}],"promo_code":"DEMO10"}

###
GET {{base}}/orders/{{order}}
Authorization: Bearer {{access_token}}

###
PUT {{base}}/orders/{{order}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{"items":[{"product_id":"{{product}}","quantity":1}]}

###
POST {{base}}/orders/{{order}}/cancel
Authorization: Bearer {{access_token}}

###
POST {{base}}/orders/{{order}}/status
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"status":"PAYMENT_PENDING"}

###
POST {{base}}/auth/refresh
Content-Type: application/json

{"refresh_token":"{{refresh_token}}"}

###
DELETE {{base}}/products/{{product}}
Authorization: Bearer {{seller_token}}
